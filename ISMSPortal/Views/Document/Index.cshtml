@model IEnumerable<ISMSPortal.ViewModels.Document.DocumentListViewModel>

@{
    ViewData["Title"] = "Document Management";
}

<partial name="_AlertMessage" />

<div class="card">

    <div class="card-header">

        <div class="row">

            <div class="col-md-6">
                <h3 class="card-title">
                    <i class="fas fa-folder-open"></i>
                    Document Management
                </h3>
            </div>

            <div class="col-md-6 text-end">

                <a asp-action="Create"
                   class="btn btn-primary">

                    <i class="fas fa-plus"></i>

                    Add Document

                </a>

            </div>

        </div>

    </div>

    <div class="card-body">

        <form asp-action="Index" method="get">

            <div class="row mb-3">

                <div class="col-md-4">

                    <input name="searchText"
                           value="@ViewBag.SearchText"
                           class="form-control"
                           placeholder="Search document..." />

                </div>

                <div class="col-md-2">

                    <button class="btn btn-primary">

                        <i class="fas fa-search"></i>

                        Search

                    </button>

                </div>

            </div>

        </form>

        <table class="table table-bordered table-hover">

            <thead class="table-light">

                <tr>

                    <th>Document No</th>

                    <th>Document Name</th>

                    <th>Category</th>

                    <th>Version</th>

                    <th>Effective Date</th>

                    <th>Status</th>

                    <th width="220">Action</th>

                </tr>

            </thead>

            <tbody>

                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.DocumentNumber</td>

                            <td>@item.DocumentName</td>

                            <td>@item.Category</td>

                            <td>@item.Version</td>

                            <td>@item.EffectiveDate.ToString("dd-MMM-yyyy")</td>

                            <td>

                                @if (item.IsPublished)
                                {
                                    <span class="badge bg-success">
                                        Published
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Draft
                                    </span>
                                }

                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@item.DocumentId"
                                   class="btn btn-info btn-sm">

                                    <i class="fas fa-eye"></i>

                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.DocumentId"
                                   class="btn btn-warning btn-sm">

                                    <i class="fas fa-edit"></i>

                                </a>

                                @if (!string.IsNullOrWhiteSpace(item.AttachmentPath))
                                {
                                    <a href="@item.AttachmentPath"
                                       target="_blank"
                                       class="btn btn-success btn-sm"
                                       title="View Document">

                                        <i class="fas fa-file-alt"></i>

                                    </a>
                                }

                                <button class="btn btn-danger btn-sm"
                                        onclick="confirmDelete(@item.DocumentId)">

                                    <i class="fas fa-trash"></i>

                                </button>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7"
                            class="text-center">

                            No documents found.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<partial name="_DeleteModal" />

@section Scripts {

    <script>

        function confirmDelete(id)
        {
            if(confirm("Are you sure you want to delete this document?"))
            {
                var form=document.createElement("form");

                form.method="post";

                form.action="/Document/Delete/"+id;

                document.body.appendChild(form);

                form.submit();
            }
        }

    </script>

}