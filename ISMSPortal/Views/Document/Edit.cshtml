@model ISMSPortal.ViewModels.Document.DocumentEditViewModel

@{
    ViewData["Title"] = "Edit Document";
}

<partial name="_PageHeader" model='"Edit Document"' />

<div class="card card-warning">
    <div class="card-body">

        <form asp-action="Edit" enctype="multipart/form-data">

            <input asp-for="DocumentId" type="hidden" />

            <partial name="_DocumentForm" model="Model" />

            <div class="mt-3">

                <button class="btn btn-warning">
                    <i class="fas fa-edit"></i> Update
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}