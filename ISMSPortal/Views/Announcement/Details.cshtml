@model ISMSPortal.ViewModels.Announcement.AnnouncementEditViewModel

@{
    ViewData["Title"] = "Announcement Details";
}

<div class="card card-info">

    <div class="card-header">
        <h3 class="card-title">
            Announcement Details
        </h3>
    </div>

    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Title</div>
            <div class="col-md-9">@Model.Title</div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Description</div>
            <div class="col-md-9">@Model.Description</div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Publish Date</div>
            <div class="col-md-9">
                @Model.PublishDate.ToString("dd-MMM-yyyy")
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Expiry Date</div>
            <div class="col-md-9">
                @(Model.ExpiryDate?.ToString("dd-MMM-yyyy") ?? "-")
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Published</div>
            <div class="col-md-9">
                @(Model.IsPublished ? "Yes" : "No")
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Pinned</div>
            <div class="col-md-9">
                @(Model.IsPinned ? "Yes" : "No")
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Display Order</div>
            <div class="col-md-9">
                @Model.DisplayOrder
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.AttachmentPath))
        {
            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Attachment</div>
                <div class="col-md-9">
                    <a href="@Model.AttachmentPath"
                       target="_blank"
                       class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-paperclip"></i>
                        View Attachment
                    </a>
                </div>
            </div>
        }

    </div>

    <div class="card-footer">

        <a asp-action="Edit"
           asp-route-id="@Model.AnnouncementId"
           class="btn btn-warning">
            <i class="fas fa-edit"></i>
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>

</div>