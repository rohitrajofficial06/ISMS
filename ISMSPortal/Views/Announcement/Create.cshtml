@model ISMSPortal.ViewModels.Announcement.AnnouncementCreateViewModel

@{
    ViewData["Title"] = "Create Announcement";
}

<div class="card card-primary">

    <div class="card-header">
        <h3 class="card-title">Create Announcement</h3>
    </div>

    <form asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        <div class="card-body">

            <partial name="_AnnouncementForm" model="Model" />

        </div>

        <div class="card-footer">

            <button type="submit"
                    class="btn btn-primary">
                Save
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}