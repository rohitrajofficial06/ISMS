@model ISMSPortal.ViewModels.Announcement.AnnouncementEditViewModel

@{
    ViewData["Title"] = "Edit Announcement";
}

<div class="card card-warning">

    <div class="card-header">
        <h3 class="card-title">Edit Announcement</h3>
    </div>

    <form asp-action="Edit"
          method="post"
          enctype="multipart/form-data">

        <input asp-for="AnnouncementId" type="hidden" />

        <div class="card-body">

            <partial name="_AnnouncementForm" model="Model" />

        </div>

        <div class="card-footer">

            <button type="submit"
                    class="btn btn-warning">
                Update
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}