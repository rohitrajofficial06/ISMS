@model IEnumerable<ISMSPortal.ViewModels.Awareness.AwarenessSessionListViewModel>

<partial name="_AlertMessage" />

<div class="card">

    <div class="card-header d-flex justify-content-between">

        <h4>Awareness Sessions</h4>

        <a asp-action="Create"
           class="btn btn-primary">

            Add Session

        </a>

    </div>

    <div class="card-body">

        <form method="get">

            <div class="row mb-3">

                <div class="col-md-4">

                    <input class="form-control"
                           name="searchText"
                           value="@ViewBag.SearchText"
                           placeholder="Search" />

                </div>

                <div class="col-md-2">

                    <button class="btn btn-primary">

                        Search

                    </button>

                </div>

            </div>

        </form>

        <table class="table table-bordered table-hover">

            <thead>

                <tr>

                    <th>Title</th>

                    <th>Date</th>

                    <th>Audience</th>

                    <th>Status</th>

                    <th width="180">Action</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.SessionTitle</td>

                        <td>@item.SessionDate.ToString("dd-MMM-yyyy")</td>

                        <td>@item.Audience</td>

                        <td>

                            @if (item.IsPublished)
                            {
                                <span class="badge bg-success">Published</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Draft</span>
                            }

                        </td>

                        <td>

                            <a asp-action="Details"
                               asp-route-id="@item.AwarenessSessionId"
                               class="btn btn-info btn-sm">

                                View

                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.AwarenessSessionId"
                               class="btn btn-warning btn-sm">

                                Edit

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>