<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - ISMS Portal</title>

    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->

    <link rel="stylesheet"
          href="~/lib/fontawesome/css/all.min.css" />

    <!-- AdminLTE -->

    <link rel="stylesheet"
          href="~/lib/admin-lte/css/adminlte.min.css" />

    <!-- Custom -->

    <link rel="stylesheet"
          href="~/css/layout.css" />

    <link rel="stylesheet"
          href="~/css/dashboard.css" />

    <link rel="stylesheet"
          href="~/css/site.css" />

</head>

<body class="hold-transition sidebar-mini layout-fixed">

    <div class="wrapper">

        <!-- Header -->

        <partial name="_TopHeader" />

        <!-- Navigation -->

        <partial name="_TopMenu" />

        <div class="content-wrapper">

            <div class="dashboard-container">

                <aside class="dashboard-sidebar">

                    <partial name="_Sidebar" />

                </aside>

                <main class="dashboard-content">

                    @RenderBody()

                </main>

            </div>

        </div>

        <!-- Footer -->

        <partial name="_Footer" />

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/admin-lte/js/adminlte.min.js"></script>

    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>