@model ISMSPortal.ViewModels.Dashboard.AwarenessProgressWidgetViewModel

<div class="card">
    <div class="card-header bg-info">
        <h3 class="card-title">@Model.Title</h3>
    </div>

    <div class="card-body">

        <h2 class="text-center">@Model.Percentage%</h2>

        <div class="progress mb-3">
            <div class="progress-bar bg-@Model.ProgressColor"
                 role="progressbar"
                 style="width:@Model.Percentage%">
            </div>
        </div>

        <table class="table table-sm">
            <tr>
                <td>Completed</td>
                <td>@Model.Completed</td>
            </tr>

            <tr>
                <td>Total</td>
                <td>@Model.Total</td>
            </tr>
        </table>

    </div>
</div>