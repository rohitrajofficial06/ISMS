@model ISMSPortal.ViewModels.Dashboard.DashboardViewModel

<div class="card card-success shadow-sm h-100">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h3 class="card-title mb-0">

            <i class="fas fa-folder-open me-2"></i>

            Recent Documents

        </h3>

        <a asp-controller="Document"
           asp-action="Index"
           class="btn btn-sm btn-light">

            View All

        </a>

    </div>

    <div class="card-body p-0">

        @if (Model.RecentDocuments.Any())
        {
            <ul class="list-group list-group-flush">

                @foreach (var item in Model.RecentDocuments)
                {
                    <li class="list-group-item">

                        <div class="fw-bold">

                            @item.Title

                        </div>

                        <small class="text-muted">

                            @item.Category

                            |

                            @item.EffectiveDate.ToString("dd MMM yyyy")

                        </small>

                    </li>
                }

            </ul>
        }
        else
        {
            <div class="text-center text-muted py-4">

                No documents available.

            </div>
        }

    </div>

</div>