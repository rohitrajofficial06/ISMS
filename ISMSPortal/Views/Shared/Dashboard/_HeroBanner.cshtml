@model ISMSPortal.ViewModels.Dashboard.HeroBannerWidgetViewModel

<div class="card shadow border-0 hero-banner mb-4">

    <div class="card-body px-5 py-5">

        <div class="row align-items-center">

            <!-- Left Content -->
            <div class="col-lg-7">

                <h1 class="hero-title mb-3">
                    @Model.Title
                </h1>

                <h2 class="hero-subtitle mb-4">
                    @Model.Subtitle
                </h2>

                <p class="hero-description mb-5">
                    @Html.Raw(Model.Description)
                </p>

                <div class="hero-buttons">

                    <a href="/Home/About"
                       class="btn btn-primary hero-btn">

                        <i class="fas fa-info-circle mr-2"></i>

                        Learn More

                    </a>

                    <a href="https://ykgwoffice.sharepoint.com/sites/YIL-ITSIN/ISMSPOLICIES/Forms/AllItems.aspx"
                       target="_blank"
                       class="btn btn-light hero-btn ml-3">

                        <i class="far fa-file-alt mr-2"></i>

                        ISMS Policy

                    </a>

                </div>

            </div>

            <!-- Right Image -->
            <div class="col-lg-5 text-center">

                <img src="@Model.BackgroundImage"
                     class="hero-image"
                     alt="ISMS Banner" />

            </div>

        </div>

    </div>

</div>