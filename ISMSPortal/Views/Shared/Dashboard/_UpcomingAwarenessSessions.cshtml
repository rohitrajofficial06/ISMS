@model IEnumerable<ISMSPortal.ViewModels.Awareness.AwarenessSessionWidgetViewModel>

<div class="card">

    <div class="card-header bg-primary">

        <h3 class="card-title">

            Upcoming Awareness Sessions

        </h3>

    </div>

    <div class="card-body">

        @foreach (var item in Model)
        {
            <div class="mb-3 border-bottom pb-2">

                <strong>@item.SessionTitle</strong>

                <br />

                <small>

                    @item.SessionDate.ToString("dd MMM yyyy")

                    |

                    @item.StartTime.ToString(@"hh\:mm")

                    -

                    @item.EndTime.ToString(@"hh\:mm")

                </small>

                <br />

                <span class="text-muted">

                    Audience: @item.Audience

                </span>

            </div>
        }

    </div>

</div>