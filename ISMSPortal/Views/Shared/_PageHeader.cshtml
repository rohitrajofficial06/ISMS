@model (string Title, string Subtitle)

<div class="content-header">

    <div class="container-fluid">

        <div class="row mb-2">

            <div class="col-sm-6">

                <h1 class="m-0">

                    @Model.Title

                </h1>

                <small class="text-muted">

                    @Model.Subtitle

                </small>

            </div>

        </div>

    </div>

</div>