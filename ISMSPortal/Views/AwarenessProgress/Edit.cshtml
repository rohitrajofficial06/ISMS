@model ISMSPortal.ViewModels.Awareness.AwarenessProgressViewModel

<partial name="_AlertMessage" />

<div class="card card-primary">

    <div class="card-header">

        <h3 class="card-title">

            Awareness Campaign Progress

        </h3>

    </div>

    <form asp-action="Edit">

        <div class="card-body">

            <input asp-for="AwarenessProgressId" type="hidden" />

            <div class="row">

                <div class="col-md-3">

                    <label asp-for="TargetEmployees"></label>

                    <input asp-for="TargetEmployees"
                           class="form-control" />

                </div>

                <div class="col-md-3">

                    <label asp-for="SessionsConducted"></label>

                    <input asp-for="SessionsConducted"
                           class="form-control" />

                </div>

                <div class="col-md-3">

                    <label asp-for="EmployeesAttended"></label>

                    <input asp-for="EmployeesAttended"
                           class="form-control" />

                </div>

                <div class="col-md-3">

                    <label asp-for="PendingEmployees"></label>

                    <input asp-for="PendingEmployees"
                           class="form-control" />

                </div>

            </div>

        </div>

        <div class="card-footer">

            <button class="btn btn-primary">

                Save

            </button>

        </div>

    </form>

</div>